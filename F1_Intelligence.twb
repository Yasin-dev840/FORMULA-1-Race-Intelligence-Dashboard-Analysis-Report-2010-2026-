              <flipboard active-id='7' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Mercedes peaked around 2019 while Red Bull stayed consistently strong, so a mid-tier team must close this gap.' captured-sheet='Team Trajectory' id='1' />
                  <story-point caption='The starting tyre makes only a small difference. Average finish is close to 10th across all compounds and circuit types.' captured-sheet='Tyre Strategy' id='2' />
                  <story-point caption='Max Verstappen and Lewis Hamilton lead in total points, which makes them the benchmark for recruitment.' captured-sheet='Driver Leaderboard' id='3' />
                  <story-point caption='Podium counts follow the points leaderboard, with Verstappen and Hamilton far ahead of the rest.' captured-sheet='Podium Achievements' id='4' />
                  <story-point caption='DNFs are spread across all failure types, so no single cause or driver dominates.' captured-sheet='Driver Reliability' id='5' />
                  <story-point caption='Race completion stayed around 92 to 96% in every season, so reliability changed little over time' captured-sheet='Reliability Trend' id='6' />
                  <story-point caption='Summary Slide.' captured-sheet='Formula 1 Race Intelligence Dashboard' id='7'>
                    <capturedDeltas>
                      <worksheet name='Tile Drivers'>
                        <selection-collection>
                          <tuple-selection>
                            <tuple-reference>
                              <tuple-descriptor>
                                <pane-descriptor>
